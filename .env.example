# Supabase Configuration
# Supabase 대시보드 → Project Settings → API 에서 확인
#
# ⚠️ 주의: 아래 두 값은 PostgreSQL 커넥션 스트링(postgresql://)이 아닙니다.
#   VITE_SUPABASE_URL  → Project URL (https://xxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY → anon/public JWT key
#
# Transaction Pooler URL(postgresql://...pooler...:6543/...)은
# 이 앱(supabase-js)에서 사용하지 않습니다.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 빌드 타임 (자동 생성, 직접 수정 불필요)
# VITE_BUILD_TIME=
